# Database
DATABASE_URL=sqlite:///./data/app.db

# Public base URL (used for tracking links)
BASE_URL=http://localhost:8000

# SMTP (sending) — use a Gmail App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true

# IMAP (reply polling). Defaults to SMTP_USERNAME / SMTP_PASSWORD if unset.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=

# From header. Defaults to SMTP_USERNAME. Set to an alias if Gmail "Send mail as" is configured.
# SENDER_EMAIL=
SENDER_NAME=Me

# Sending
DAILY_SEND_CAP=100

# Random delay between consecutive sends in a tick, to avoid looking automated. Set both to 0 to disable.
SEND_JITTER_MIN_SECONDS=2
SEND_JITTER_MAX_SECONDS=10
# Per-send send_at jitter (minutes) applied at enrollment time so step send times aren't on round boundaries. 0 = no jitter.
SEND_AT_JITTER_MINUTES=30
# Safety cap: max sends processed per tick to prevent a single tick from blocking too long.
MAX_SENDS_PER_TICK=5

# Business-hours sending window. When enabled, sends only go out within the window
# (in SEND_TIMEZONE). Reply polling is unaffected.
SEND_WINDOW_ENABLED=true
SEND_TIMEZONE=America/New_York
SEND_HOUR_START=9
SEND_HOUR_END=18
SEND_WEEKDAYS_ONLY=true

# Security
TRACKING_SECRET=change-me

# Basic auth for the web UI + API. Leave both blank to disable auth.
# Tracking endpoints (/t/o/*, /t/c/*) are always public regardless of these.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Unsubscribe keyword (case-insensitive substring match in replies)
UNSUBSCRIBE_KEYWORD=unsubscribe

# Nightly SQLite backups (cron at BACKUP_HOUR_UTC:00 UTC, retains BACKUP_RETAIN snapshots)
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_HOUR_UTC=21
BACKUP_RETAIN=14
